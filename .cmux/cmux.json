{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "commands": [
    {
      "name": "Hitch (default — prod server)",
      "description": "Run the desktop app against the Railway production server. This is the default dev setup: `npm run dev` points at prod so local testing matches the shipped user experience.",
      "keywords": ["hitch", "dev", "default", "prod", "railway", "desktop", "electron"],
      "workspace": {
        "name": "Hitch",
        "cwd": ".",
        "restart": "confirm",
        "layout": {
          "pane": {
            "surfaces": [
              {
                "type": "terminal",
                "name": "App (prod server)",
                "command": "npm run dev",
                "focus": true
              }
            ]
          }
        }
      }
    },
    {
      "name": "Hitch (local server)",
      "description": "Run against a local server instead of prod: compose (server+postgres+garage), renderer, and Electron pointed at :3010. Use when changing the server or when prod data must not be touched.",
      "keywords": ["hitch", "dev", "local", "server", "compose", "desktop", "electron"],
      "workspace": {
        "name": "Hitch Local",
        "cwd": ".",
        "restart": "confirm",
        "layout": {
          "pane": {
            "surfaces": [
              {
                "type": "terminal",
                "name": "Stack",
                "command": "docker compose up",
                "focus": true
              },
              {
                "type": "terminal",
                "name": "Renderer",
                "command": "npm run dev:renderer"
              },
              {
                "type": "terminal",
                "name": "Electron (V2)",
                "command": "HITCH_SERVER_URL=http://localhost:3010 npm run dev:electron"
              }
            ]
          }
        }
      }
    }
  ]
}
